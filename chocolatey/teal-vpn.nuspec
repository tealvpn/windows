    <id>teal-vpn</id>
    <version>0.1.30</version>
    <packageSourceUrl>https://github.com/tealvpn/windows/tree/main/chocolatey</packageSourceUrl>
    <owners>Fxolio LLC</owners>
    <title>Teal VPN</title>
    <authors>Fxolio LLC</authors>
